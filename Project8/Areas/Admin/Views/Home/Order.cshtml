@model IEnumerable<WebBanSach.Models.Data.DonDatHang>


@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Quản lý đơn hàng</h2>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th>Mã Đơn</th>
            <th>Khách Hàng</th>
            <th>Ngày Đặt</th>
            <th>Ngày Giao</th>
            @*<th>Trạng Thái Giao</th>*@
            <th>Trạng Thái</th>
            <th>Chi tiết</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row_@item.MaDDH">
                <td>@item.MaDDH</td>
                <td>@item.KhachHang.TenKH</td>
                <td>@item.NgayDat</td>
                <td>@item.NgayGiao</td>
               

                @*<td>
                        <select class="form-control status-select" data-id="@item.MaDDH">
                            <option value="false" @(item.TinhTrang == false ? "selected" : "")>Chưa giao</option>
                            <option value="true" @(item.TinhTrang == true ? "selected" : "")>Đã giao</option>
                        </select>
                    </td>*@

                <td>
                    <select class="form-control tracking-select" data-id="@item.MaDDH">
                        <option value="0" @(item.Tracking == 0 ? "selected" : "")>🕒 Đang xử lý</option>
                        <option value="1" @(item.Tracking == 1 ? "selected" : "")>📦 Đã đóng gói</option>
                        <option value="2" @(item.Tracking == 2 ? "selected" : "")>🚚 Đang giao</option>
                        <option value="3" @(item.Tracking == 3 ? "selected" : "")>✅ Giao thành công</option>

                    </select>
                </td>

                <td>
                    @Html.ActionLink("Xem", "DetailsOrder", new { id = item.MaDDH })
                    @Ajax.ActionLink("Xóa", "DeleteOrder", new { id = item.MaDDH }, new AjaxOptions
                    {
                        Confirm = "Bạn có chắc muốn xóa đơn hàng này?",
                        HttpMethod = "Post",
                        OnSuccess = "onDeleteOrderComplete"
                    }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".tracking-select").change(function () {
                var $select = $(this); // lưu lại select hiện tại
                var id = $select.data("id");
                var tracking = $select.val();

                $.post("/Admin/Home/UpdateTracking", { id: id, tracking: tracking }, function (res) {
                    if (res.success) {
                        alert("✅ Đã cập nhật trạng thái vận chuyển!");
                        // Có thể cập nhật màu sắc hoặc text hiển thị ở đây nếu muốn
                    } else {
                        alert("❌ Lỗi khi cập nhật trạng thái.");
                        // Nếu cần, reset lại giá trị cũ
                        $select.val($select.data("old"));
                    }
                });
            });
        });
        function onDeleteOrderComplete(response) {
            if (response.success) {
                $('#row_' + response.id).remove();
                alert("✅ " + response.message);
            } else {
                alert("❌ " + response.message);
            }
        }

    </script>

}


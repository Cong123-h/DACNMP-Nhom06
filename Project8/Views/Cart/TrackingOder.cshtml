@model IEnumerable<WebBanSach.Models.Data.DonDatHang>
@{
    ViewBag.Title = "TrackingOrder";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Đơn Hàng Của Bạn</h2>

@if (Model.Any())
{
    <table class="table" id="myTable">
        <thead>
            <tr>
                <th>Mã Đơn Hàng</th>
                <th>Ngày Đặt</th>
                <th>Ngày Giao</th>
                <th>Trạng Thái Vận Chuyển</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Reverse())
            {
                <tr id="row_@item.MaDDH">
                    <td>@item.MaDDH</td>
                    <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
                    <td>@item.NgayGiao.ToString("dd/MM/yyyy")</td>
                 
                    <td>
                        @{
                            var trackingText = "";
                            switch (item.Tracking)
                            {
                                case 0: trackingText = "🕒 Đang xử lý"; break;
                                case 1: trackingText = "📦 Đã đóng gói"; break;
                                case 2: trackingText = "🚚 Đang giao"; break;
                                case 3: trackingText = "✅ Giao thành công"; break;
                            }
                            
                        }
                        @trackingText
                    </td>
                    <td>
                        <a href="@Url.Action("TrackingOderDetails", "Cart", new { id = item.MaDDH })" class="btn btn-info btn-sm">Xem chi tiết</a>
                        <button class="btn btn-danger btn-sm btn-delete" data-id="@item.MaDDH">Hủy Đơn</button>
                    </td>
                </tr>
            }
            
        </tbody>
    </table>
}
else
{
    <div style="color:red;margin-top:50px;">Xin lỗi, bạn chưa có đơn hàng nào!</div>
}
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function () {
                if (!confirm("Bạn có chắc muốn xóa đơn hàng này?")) return;

                var id = $(this).data("id");
                var row = $(this).closest("tr");

                $.ajax({
                    url: '/Cart/DeleteOrder',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            row.remove();
                            alert("✅ " + res.message);
                        } else {
                            alert("❌ " + res.message);
                        }
                    },
                    error: function () {
                        alert("❌ Có lỗi xảy ra khi xóa đơn hàng.");
                    }
                });
            });
        });
    </script>
}
@model IEnumerable<WebBanSach.Models.Data.ChiTietDDH>
@{
    ViewBag.Title = "Chi Tiết Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Chi Tiết Đơn Hàng</h2>
@{
    decimal? tongTien = 0;
    foreach (var item in Model)
    {
        tongTien += item.DonGia * item.SoLuong;
    }
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên Sách</th>
            <th>Số Lượng</th>
            <th>Đơn Giá</th>
            <th>Thành Tiền</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sach.TenSach</td>
                <td>@item.SoLuong</td>
                <td>@String.Format("{0:#,##0} đ", item.DonGia)</td>
                <td>@String.Format("{0:#,##0} đ", item.DonGia * item.SoLuong)</td>
                

            </tr>
        }
            <tr>
                <td colspan="3" style="text-align: right; font-weight: bold;">Tổng cộng:</td>
                <td style="font-weight: bold;">@String.Format("{0:#,##0} đ", tongTien)</td>
            </tr>
    </tbody>
</table>

<a href="@Url.Action("TrackingOder", "Cart")" class="btn btn-secondary">← Quay lại danh sách đơn hàng</a>
